# Grok Trading Brain Environment Configuration

# Trading Mode: 'demo' (safe paper trading simulation) or 'real' (live execution)
TRADING_MODE=demo

# Delta Exchange India API Credentials
# Get these from: https://india.delta.exchange/app/account/api
DELTA_INDIA_API_KEY=your_delta_india_api_key_here
DELTA_INDIA_API_SECRET=your_delta_india_api_secret_here
DELTA_INDIA_BASE_URL=https://api.india.delta.exchange

# Initial Capital / Starting Equity (USD/USDT)
STARTING_EQUITY=1000.0

# Trading Loop Check Interval (Seconds)
CHECK_INTERVAL_SECONDS=60

# Server IP / Public Whitelist IP configuration
SERVER_IP=45.251.233.150
